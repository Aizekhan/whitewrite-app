{
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "storage": {
    "rules": "storage.rules"
  },
  "functions": {
    "source": "functions",
    "runtime": "nodejs22",
    "codebase": "default",
    "ignore": [
      "node_modules",
      ".git",
      "firebase-debug.log",
      "firebase-debug.*.log",
      "*.local",
      "*.png",
      "console-logs-projectid.txt",
      "manual-test-instructions.md",
      ".env.yaml.template",
      "test-*.js",
      "test-*.cjs",
      "check-*.js",
      "migrate-*.js",
      "set-*.js",
      "count-legacy-users.js",
      "calculate-opus-economics.js",
      "simple-console-check.js"
    ]
  },
  "hosting": {
    "public": "dist",
    "predeploy": ["node scripts/build-app.mjs"],
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "headers": [
      {
        "source": "**/*.html",
        "headers": [
          { "key": "Cache-Control", "value": "no-cache" }
        ]
      },
      {
        "source": "/",
        "headers": [
          { "key": "Cache-Control", "value": "no-cache" }
        ]
      },
      {
        "source": "**",
        "headers": [
          { "key": "X-Content-Type-Options", "value": "nosniff" },
          { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
          { "key": "Content-Security-Policy", "value": "frame-ancestors 'self'; object-src 'none'; base-uri 'self'" },
          { "key": "Content-Security-Policy-Report-Only", "value": "default-src 'self'; script-src 'self' 'unsafe-inline' https://unpkg.com https://www.gstatic.com https://js.stripe.com https://apis.google.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: blob: https:; media-src 'self' blob: https://firebasestorage.googleapis.com; connect-src 'self' https://*.googleapis.com https://us-central1-whitewrite-app.cloudfunctions.net https://api.stripe.com; frame-src 'self' https://whitewrite-app.firebaseapp.com https://js.stripe.com https://hooks.stripe.com; worker-src 'self' blob:; form-action 'self'" }
        ]
      }
    ],
    "rewrites": [
      {
        "source": "/",
        "destination": "/White.html"
      }
    ],
    "redirects": [
      { "source": "/WhiteWrite WorldTree.html", "destination": "/", "type": 301 },
      { "source": "/WhiteWrite%20WorldTree.html", "destination": "/", "type": 301 },
      { "source": "/WhiteWrite Workspace.html", "destination": "/", "type": 301 },
      { "source": "/WhiteWrite%20Workspace.html", "destination": "/", "type": 301 }
    ]
  }
}
