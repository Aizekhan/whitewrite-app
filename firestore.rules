rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    function isProjectOwner(projectId) {
      return get(/databases/$(database)/documents/projects/$(projectId)).data.owner == request.auth.uid;
    }

    // Users collection
    // Billing fields (plan, tokens*, bonusTokens, periodStart, subscription*, processedOrders, ...)
    // are server-only: written exclusively by Cloud Functions / payment webhooks.
    function clientUserFields() {
      return ['email', 'displayName', 'avatar', 'language', 'settings', 'updatedAt'];
    }

    match /users/{userId} {
      allow read: if isAuthenticated() && isOwner(userId);
      // Client may only bootstrap a free account with nothing spent
      allow create: if isAuthenticated() && isOwner(userId) &&
                       request.resource.data.keys().hasOnly(clientUserFields().concat(['plan', 'createdAt'])) &&
                       request.resource.data.plan == 'free';
      allow update: if isAuthenticated() && isOwner(userId) &&
                       request.resource.data.diff(resource.data).affectedKeys().hasOnly(clientUserFields());
      allow delete: if false; // Users can't delete themselves via client
    }
    // «Історія токенів» (functions/src/ledger.js): every move of the user's tokens — the owner reads, only the server writes
    match /users/{userId}/ledger/{entryId} {
      allow read: if isAuthenticated() && isOwner(userId);
      allow write: if false;
    }

    // Worlds (canon = source of truth). Stories (projects) reference a world via worldId.
    function isWorldOwner(worldId) {
      return get(/databases/$(database)/documents/worlds/$(worldId)).data.owner == request.auth.uid;
    }
    // Маркет (functions/src/market.js): a world under licence review or on sale is FROZEN — worlds/{w}.freeze is set and
    // cleared only by the server; until then nothing in the world, its games or its stories changes from the client
    function worldOpen(worldId) {
      return get(/databases/$(database)/documents/worlds/$(worldId)).data.get('freeze', null) == null;
    }
    // writes under a game need the game: no cards / quests / plan under a made-up id (past maxGames, functions/src/projects.js)
    function gameExists(worldId, gameId) {
      return exists(/databases/$(database)/documents/worlds/$(worldId)/games/$(gameId));
    }
    // 🎓 the demo game (games/{g}.demo, set only by projects.js createGame { demo }) is read-only for every client: nothing under it is
    // created or changed — the author copies it («⧉ Скопіювати як мою гру»); only the world owner deletes it (gamebible.js removeGame)
    function notDemo(worldId, gameId) {
      return !exists(/databases/$(database)/documents/worlds/$(worldId)/games/$(gameId)) ||
             get(/databases/$(database)/documents/worlds/$(worldId)/games/$(gameId)).data.get('demo', false) != true;
    }
    // Команда (functions/src/team.js): worlds/{w}.team.{uid} = { role: admin|editor|viewer|custom, view[], edit[], viewKinds[], editKinds[] },
    // written only by the server. admin / editor read and write everything (admin's ✦ is paid by the owner on the server),
    // viewer reads everything, custom reads `view` and writes `edit` (Bible menu ids; entity kinds for the canon dossiers).
    function mem(worldId) {
      return get(/databases/$(database)/documents/worlds/$(worldId)).data.get('team', {}).get(request.auth.uid, null);
    }
    function fullRead(worldId) {
      return isWorldOwner(worldId) || (mem(worldId) != null && mem(worldId).role in ['admin', 'editor', 'viewer']);
    }
    function fullEdit(worldId) {
      return isWorldOwner(worldId) || (mem(worldId) != null && mem(worldId).role in ['admin', 'editor']);
    }
    function readSec(worldId, sec) {
      return fullRead(worldId) || (mem(worldId) != null && sec in mem(worldId).get('view', []));
    }
    function editSec(worldId, sec) {
      return fullEdit(worldId) || (mem(worldId) != null && sec in mem(worldId).get('edit', []));
    }
    function readKind(worldId, kind) {
      return fullRead(worldId) || (mem(worldId) != null && kind in mem(worldId).get('viewKinds', []));
    }
    function editKind(worldId, kind) {
      return fullEdit(worldId) || (mem(worldId) != null && kind in mem(worldId).get('editKinds', []));
    }
    function anyAccess(worldId) {
      return isWorldOwner(worldId) || mem(worldId) != null;
    }
    // game writes need Game Dev on the OWNER's plan (members work in the owner's world). The list = the plans whose planBudget has
    // allowGameDev (functions/paid-features.js); tests/canon-plans.test.cjs keeps it (and hasGameDev, storage.rules ownerGameDev) equal to the registry
    function ownerGameDev(worldId) {
      return get(/databases/$(database)/documents/users/$(get(/databases/$(database)/documents/worlds/$(worldId)).data.owner)).data.get('plan', 'free') in ['worldbuilder', 'worldforge'];
    }
    // Канон (v2.118.0): editing the canon needs the OWNER's plan to open it — the registry's feature 'bible' (flag allowWorldTree,
    // functions/paid-features.js). The list = the plans whose planBudget has allowWorldTree; tests/canon-plans.test.cjs checks it
    // against the registry. A fresh world (≤ 30 min after createdAt) is filled on any plan: Genesis / restore / «Заповни світ» write it
    // from the client right after creating it (app/firebase/firebase-canon.js createWorld, gamebible.js restoreJson / applyFill).
    function canonPlans() {
      return ['storyteller', 'novelist', 'worldbuilder', 'worldforge'];
    }
    // createdAt is the server's clock: the create must write request.time (serverTimestamp) and no update changes it (audit 2026-11-19 —
    // a client-written future createdAt kept a Free world «fresh» forever); a value from the future is never fresh
    function freshWorld(w) {
      let c = w.get('createdAt', timestamp.value(0));
      return c is timestamp && c <= request.time && request.time < c + duration.value(30, 'm');
    }
    function canonOpen(worldId) {
      let w = get(/databases/$(database)/documents/worlds/$(worldId)).data;
      return get(/databases/$(database)/documents/users/$(w.owner)).data.get('plan', 'free') in canonPlans() || freshWorld(w);
    }
    // world-doc fields that are the canon (the overview's tagline stays open: the shell's world card edits it with the title on any plan)
    function canonWorldKeys() {
      return ['summary', 'facts', 'rules', 'subsections', 'timeUnit', 'auditAnswers', 'maps', 'mapImage'];
    }
    // the Bible menu section of a game subcollection (cards carry their own `section`)
    function subSec(sub) {
      return sub in ['plan', 'tasks', 'changeRequests', 'executions'] ? 'plan'
        : sub in ['experienceIssues', 'experiments', 'playtests', 'telemetry', 'telemetryDaily', 'experience'] ? 'experience'
        : sub in ['knowledge', 'kAssets', 'kRelations'] ? 'knowledge'
        : sub in ['marketing', 'channels', 'posts'] ? 'marketing'
        : sub == 'env' ? 'settings'
        : sub == 'agentMessages' ? 'agents' : sub; // 💬 Агенти (v2.148): written by the server only (functions/src/agents.js, mcp.js)
    }
    // optional fields the Game Bible writes on a game doc of `sub` (v2.78.1): a bug task (kind, severity, repro…) and an A/B decision;
    // absent fields pass, so the older task / experiment writes are unchanged
    function optStr(d, k, max) {
      return !(k in d) || (d[k] is string && d[k].size() <= max);
    }
    // an optional field from a fixed list (audit 2026-11-19: status / priority / assetState went into class attributes of the owner's page —
    // the page escapes them now, the rules keep them to the values the Bible and the functions write)
    function optIn(d, k, vals) {
      return !(k in d) || d[k] in vals;
    }
    function gameDocOk(sub, d) {
      return (sub != 'tasks' || (
                (!('kind' in d) || d.kind in ['task', 'bug', 'author', 'sync']) &&
                (!('severity' in d) || d.severity in ['s1', 's2', 's3', 's4']) &&
                optIn(d, 'status', ['todo', 'in_progress', 'review', 'rework', 'blocked', 'done', 'deferred', 'dropped']) &&
                optIn(d, 'priority', ['', 'must', 'should', 'could']) &&
                optIn(d, 'assetState', ['', 'greybox', 'standin', 'styled', 'final']) &&
                optStr(d, 'repro', 4000) && optStr(d, 'expected', 2000) && optStr(d, 'actual', 2000) &&
                optStr(d, 'build', 80) && optStr(d, 'foundIn', 120))) &&
             (sub != 'experiments' || (
                optIn(d, 'status', ['running', 'done']) &&
                (!('decision' in d) || d.decision in ['ship', 'kill', 'iterate']) && optStr(d, 'decisionNote', 2000))) &&
             (sub != 'experienceIssues' || (
                optIn(d, 'status', ['open', 'planned', 'validating', 'awaiting', 'resolved', 'dismissed']) &&
                optIn(d, 'priority', ['high', 'medium', 'low']) && optIn(d, 'confidence', ['low', 'medium', 'high']) &&
                optStr(d, 'category', 40) && optStr(d, 'chosenAction', 2000))) &&
             (sub != 'playtests' || optIn(d, 'status', ['draft', 'active', 'done'])) &&
             (sub != 'changeRequests' || optIn(d, 'status', ['open', 'accepted', 'rejected', 'declined'])) &&
             (!(sub in ['quests', 'dialogues']) || optIn(d, 'approval', ['draft', 'review', 'approved', 'archived']));
    }
    // A team member's writes the owner's Claude Code would read as the author's word (audit 2026-11-19): only the owner approves a gate,
    // changes the gating or a milestone, deletes the plan, approves a quest / dialogue; on a change request a member only decides it,
    // on an experience issue / playtest only moves its status. Owners write as before.
    function memberSubOk(worldId, sub, docId) {
      return isWorldOwner(worldId) || (
        (sub != 'plan' || (request.method != 'delete' && docId == 'current' && memberPlanOk())) &&
        (sub != 'changeRequests' || (request.method == 'update' &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'decidedAt']) && request.resource.data.status in ['accepted', 'rejected'])) &&
        (sub != 'experienceIssues' || (request.method == 'update' &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'taskId', 'chosenAction', 'updatedAt']))) &&
        (sub != 'playtests' || (request.method == 'update' &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt']))) &&
        (!(sub in ['quests', 'dialogues']) || request.method == 'delete' ||
          request.resource.data.get('approval', 'draft') != 'approved' || (resource != null && resource.data.get('approval', 'draft') == 'approved')));
    }
    // plan/current from a member: the answers, resolved contradictions, imported questions, the scaffold mark — and the plan itself only
    // by one hand-made milestone EXP / MAP (gamebible.js addManualTask: «Досвід гравців» / «Карта гри» tasks), never gates or the gating
    function memberPlanOk() {
      let old = resource == null ? {} : resource.data;
      let keys = request.resource.data.diff(old).affectedKeys();
      return keys.hasOnly(['answers', 'answeredAt', 'resolved', 'asked', 'contradictions', 'scaffold', 'plan', 'updatedAt']) &&
             (!keys.hasAny(['plan']) || memberMilestoneOk(old.get('plan', {}), request.resource.data.plan));
    }
    function memberMilestoneOk(o, n) {
      let om = o.get('milestones', []);
      let nm = n.get('milestones', []);
      let added = nm.removeAll(om);
      let gone = om.removeAll(nm);
      return n.diff(o).affectedKeys().hasOnly(['milestones']) && nm.size() <= om.size() + 1 && added.size() <= 1 && gone.size() <= 1 &&
             (added.size() == 0 || (added[0].get('id', '') in ['EXP', 'MAP'] && !added[0].keys().hasAny(['track', 'accept', 'budgets']) && added[0].get('gate', '') == '')) &&
             (gone.size() == 0 || (added.size() == 1 && gone[0].get('id', '') == added[0].get('id', '')));
    }
    // the game's own sections (games/{g}.sections [{ id, name, about, group }], gamebible.js «＋ Свій розділ»): ids go into attributes and
    // menu ids — letters, digits, _ . : - only (rules cannot loop, so each of the at most 60 is checked by its index)
    function secOk(l, i) {
      return i >= l.size() || (l[i] is map && l[i].get('id', '') is string && l[i].get('id', '').matches('[\\p{L}\\p{N}_.:-]{1,80}') &&
                               l[i].get('name', '') is string && l[i].get('name', '').size() <= 200 && l[i].get('about', '') is string && l[i].get('about', '').size() <= 2000);
    }
    function secsOk(l) {
      return l is list && l.size() <= 60 &&
             secOk(l, 0) && secOk(l, 1) && secOk(l, 2) && secOk(l, 3) && secOk(l, 4) && secOk(l, 5) && secOk(l, 6) && secOk(l, 7) && secOk(l, 8) && secOk(l, 9) &&
             secOk(l, 10) && secOk(l, 11) && secOk(l, 12) && secOk(l, 13) && secOk(l, 14) && secOk(l, 15) && secOk(l, 16) && secOk(l, 17) && secOk(l, 18) && secOk(l, 19) &&
             secOk(l, 20) && secOk(l, 21) && secOk(l, 22) && secOk(l, 23) && secOk(l, 24) && secOk(l, 25) && secOk(l, 26) && secOk(l, 27) && secOk(l, 28) && secOk(l, 29) &&
             secOk(l, 30) && secOk(l, 31) && secOk(l, 32) && secOk(l, 33) && secOk(l, 34) && secOk(l, 35) && secOk(l, 36) && secOk(l, 37) && secOk(l, 38) && secOk(l, 39) &&
             secOk(l, 40) && secOk(l, 41) && secOk(l, 42) && secOk(l, 43) && secOk(l, 44) && secOk(l, 45) && secOk(l, 46) && secOk(l, 47) && secOk(l, 48) && secOk(l, 49) &&
             secOk(l, 50) && secOk(l, 51) && secOk(l, 52) && secOk(l, 53) && secOk(l, 54) && secOk(l, 55) && secOk(l, 56) && secOk(l, 57) && secOk(l, 58) && secOk(l, 59);
    }
    function storyOpen(projectId) {
      let w = get(/databases/$(database)/documents/projects/$(projectId)).data.get('worldId', null);
      return w == null || worldOpen(w);
    }

    match /worlds/{worldId} {
      allow read: if isAuthenticated() && (resource.data.owner == request.auth.uid || request.auth.uid in resource.data.get('teamUids', []));
      allow delete: if isAuthenticated() && resource.data.owner == request.auth.uid && resource.data.get('freeze', null) == null;
      // worlds/{w}.cosmograph (Космограф access, paid monthly) is written only by functions/src/cosmograph.js; .freeze — by market.js
      // .team / .teamUids — team.js; .backup — backup.js; .integrations — integrations.js
      allow create: if isAuthenticated() && request.resource.data.owner == request.auth.uid &&
                       !request.resource.data.keys().hasAny(['cosmograph', 'freeze', 'team', 'teamUids', 'backup', 'licence', 'boughtFrom', 'boughtAt', 'integrations']) &&
                       (!('createdAt' in request.resource.data) || request.resource.data.createdAt == request.time); // serverTimestamp() — freshWorld trusts it
      allow update: if isAuthenticated() && resource.data.get('freeze', null) == null &&
                       !request.resource.data.diff(resource.data).affectedKeys().hasAny(['owner', 'createdAt', 'cosmograph', 'freeze', 'team', 'teamUids', 'backup', 'licence', 'boughtFrom', 'boughtAt', 'integrations']) &&
                       (resource.data.owner == request.auth.uid || memberWorldEdit()) &&
                       (!request.resource.data.diff(resource.data).affectedKeys().hasAny(canonWorldKeys()) || worldCanonOpen());
      function worldCanonOpen() {
        return get(/databases/$(database)/documents/users/$(resource.data.owner)).data.get('plan', 'free') in canonPlans() || freshWorld(resource.data);
      }
      // a member with the right to a section edits its world-doc fields: the overview, laws, the sky, the subsections of the sections
      // they edit (subsections.{sectionId}), the chronicle's time unit, the answers of «Неузгоджене» (canonIssues)
      function memberWorldEdit() {
        let m = resource.data.get('team', {}).get(request.auth.uid, null);
        let keys = request.resource.data.diff(resource.data).affectedKeys();
        return m != null && keys.hasOnly(['tagline', 'summary', 'facts', 'rules', 'cosmos', 'subsections', 'timeUnit', 'auditAnswers', 'updatedAt']) &&
               (m.role in ['admin', 'editor'] || (
                 (!keys.hasAny(['tagline', 'summary', 'facts']) || 'world' in m.get('edit', [])) &&
                 (!keys.hasAny(['rules']) || 'laws' in m.get('edit', [])) &&
                 (!keys.hasAny(['cosmos']) || 'cosmology' in m.get('edit', [])) &&
                 (!keys.hasAny(['timeUnit']) || 'chronicle' in m.get('edit', [])) &&
                 (!keys.hasAny(['auditAnswers']) || 'canonIssues' in m.get('edit', [])) &&
                 (!keys.hasAny(['subsections']) || request.resource.data.subsections.diff(resource.data.get('subsections', {})).affectedKeys().hasOnly(m.get('edit', [])))));
      }

      match /entities/{entityId} {
        allow read: if isAuthenticated() && readKind(worldId, resource.data.kind);
        // + the owner's plan opens canon editing (canonOpen; a world on Free is read-only after its first 30 minutes)
        allow create: if isAuthenticated() && editKind(worldId, request.resource.data.kind) && worldOpen(worldId) && canonOpen(worldId);
        // the kind it has now too: a member may not pull another kind's entity into theirs
        allow update: if isAuthenticated() && editKind(worldId, resource.data.kind) && editKind(worldId, request.resource.data.kind) && worldOpen(worldId) && canonOpen(worldId);
        allow delete: if isAuthenticated() && editKind(worldId, resource.data.kind) && worldOpen(worldId) && canonOpen(worldId);
      }

      // Culture of the world (peoples, languages, faith, customs) — World Bible «Культура».
      match /lore/{loreId} {
        allow read: if isAuthenticated() && readSec(worldId, 'culture');
        allow write: if isAuthenticated() && editSec(worldId, 'culture') && worldOpen(worldId) && canonOpen(worldId);
      }

      // Games built on this canon (one canon → many games): game doc + cards + production plan.
      // Game design (the game doc, cards, quests, dialogues) is open on every plan (paid-features.js allowGameDesign); a game is
      // CREATED only by the createGame function (the plan's maxGames). The production plan, tasks and player experience
      // need allowGameDev on the owner's plan (Worldbuilder). Reading stays with the owner whatever the plan.
      // Only the subcollections the Game Bible page itself edits are client-writable; everything else under a game
      // (telemetry, telemetryDaily, experience metrics, executions, and every future server-side record: activity log,
      // project knowledge, marketing posts…) is written by Cloud Functions only — the owner reads it.
      match /games/{gameId} {
        allow read: if isAuthenticated() && anyAccess(worldId);
        allow create: if false; // functions/src/projects.js createGame
        // .repo / .ingestKeys / .integrations / .framework — server only (gamedev.js repoConnect, experience.js keys, integrations.js, mcp.js report_framework_capabilities);
        // .telemetryStats (experience.js telemetryIngest), .knowledge (mcp.js submit_project_knowledge), .audit / .auditRunning (gamedev.js), .demo (projects.js createGame — the
        // 🎓 demo game outside the plan's game limit) — server only too; .launch builds the PowerShell lines
        // the OWNER pastes on their PC (gamebible.js «Запуск Claude Code») — so only the owner changes it
        allow update: if isAuthenticated() && worldOpen(worldId) && resource.data.get('demo', false) != true && ((fullEdit(worldId) &&
                         !request.resource.data.diff(resource.data).affectedKeys().hasAny(['repo', 'ingestKeys', 'integrations', 'framework', 'telemetryStats', 'knowledge', 'audit', 'auditRunning', 'demo']) &&
                         (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['launch']) || isWorldOwner(worldId)) &&
                         (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['sections']) || secsOk(request.resource.data.sections))) || memberGameEdit());
        // a «вибрані розділи» member writes on the game doc only what belongs to their sections: the subsections and the 🎨 group
        // palettes of a section they edit, and the 🎙 voices (games/{g}.voices) with «Діалоги» or a character / enemy section
        function memberGameEdit() {
          let m = mem(worldId);
          let e = m == null ? [] : m.get('edit', []);
          let keys = request.resource.data.diff(resource.data).affectedKeys();
          return m != null && m.role == 'custom' && keys.hasOnly(['subsections', 'subtypes', 'subPalettes', 'voices', 'updatedAt']) &&
                 (!keys.hasAny(['subsections']) || request.resource.data.subsections.diff(resource.data.get('subsections', {})).affectedKeys().hasOnly(e)) &&
                 (!keys.hasAny(['subtypes']) || request.resource.data.subtypes.diff(resource.data.get('subtypes', {})).affectedKeys().hasOnly(e)) &&
                 (!keys.hasAny(['subPalettes']) || request.resource.data.subPalettes.diff(resource.data.get('subPalettes', {})).affectedKeys().hasOnly(e)) &&
                 (!keys.hasAny(['voices']) || e.hasAny(['dialogues', 'characters', 'enemies']));
        }
        // the owner only: deleting a game is final (functions/src/cleanup.js gameDeleted removes everything under it)
        allow delete: if isAuthenticated() && isWorldOwner(worldId) && worldOpen(worldId);
      }
      // cards: by their own section (a member with chosen sections queries one section at a time)
      match /games/{gameId}/cards/{cardId} {
        allow read: if isAuthenticated() && readSec(worldId, resource.data.section);
        allow create: if isAuthenticated() && editSec(worldId, request.resource.data.section) && worldOpen(worldId) && gameExists(worldId, gameId) && notDemo(worldId, gameId);
        // the section it is in now too: a member may not pull another section's card into theirs
        allow update: if isAuthenticated() && editSec(worldId, resource.data.section) && editSec(worldId, request.resource.data.section) && worldOpen(worldId) && notDemo(worldId, gameId);
        allow delete: if isAuthenticated() && editSec(worldId, resource.data.section) && worldOpen(worldId) && (isWorldOwner(worldId) || notDemo(worldId, gameId));
      }
      match /games/{gameId}/{sub}/{docId} {
        allow read: if isAuthenticated() && sub != 'cards' && readSec(worldId, subSec(sub));
        allow write: if isAuthenticated() && sub != 'cards' && editSec(worldId, subSec(sub)) && worldOpen(worldId) &&
                        (sub in ['quests', 'dialogues'] ||
                         (sub in ['plan', 'tasks', 'changeRequests', 'experienceIssues', 'experiments', 'playtests'] && ownerGameDev(worldId))) &&
                        (request.method == 'delete' || (gameDocOk(sub, request.resource.data) && gameExists(worldId, gameId))) &&
                        ((request.method == 'delete' && isWorldOwner(worldId)) || notDemo(worldId, gameId)) &&
                        memberSubOk(worldId, sub, docId) &&
                        // a task a member writes carries memberEdit = their uid: the owner's Claude Code (MCP) holds it until the owner
                        // approves (clears it) — a member's text never runs as the owner's instruction on the owner's PC
                        (sub != 'tasks' || request.method == 'delete' || isWorldOwner(worldId) || request.resource.data.get('memberEdit', null) == request.auth.uid);
        // the author deleting the game (server-written records: executor log, Project Knowledge, activity log, environment)
        allow delete: if isAuthenticated() && isWorldOwner(worldId) && worldOpen(worldId) &&
                         sub in ['executions', 'knowledge', 'kAssets', 'kRelations', 'activity', 'env', 'posts', 'channels', 'marketing', 'agentMessages'];
      }
      match /games/{gameId}/{sub}/{docId}/{rest=**} {
        allow read: if isAuthenticated() && readSec(worldId, subSec(sub));
      }
      // Development activity log: Claude Code writes entries (MCP); the author only re-marks privacy, or deletes with the game
      match /games/{gameId}/activity/{sessionId}/entries/{entryId} {
        allow update: if isAuthenticated() && isWorldOwner(worldId) && hasGameDev() && worldOpen(worldId) && notDemo(worldId, gameId) &&
                         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['privacy', 'reviewedAt']) &&
                         request.resource.data.privacy in ['internal', 'confidential', 'spoiler', 'excluded', 'marketing_approved'];
        allow delete: if isAuthenticated() && isWorldOwner(worldId);
      }
    }

    // Друзі (team.js): the owner reads, only the server writes
    match /users/{userId}/friends/{friendId} {
      allow read: if isAuthenticated() && isOwner(userId);
      allow write: if false;
    }
    // The author's one saved GitHub token (github-token.js) — reused by the repo and backup connections, server only
    match /githubTokens/{uid} {
      allow read, write: if false;
    }
    // Storage upload locks (functions/src/storage-quota.js, per uid) — server only
    match /storageLocks/{uid} {
      allow read, write: if false;
    }
    // Storage quota (functions/src/storage-quota.js): bytes per world, the owner reads their own (the page checks before an upload)
    match /storageUsage/{worldId} {
      allow read: if isAuthenticated() && resource.data.owner == request.auth.uid;
      allow write: if false;
    }
    // 🔌 the author's own keys for 3D / image generation (integrations.js) — server only; the page sees worlds|games.integrations
    match /integrationKeys/{id} {
      allow read, write: if false;
    }
    // GitHub tokens of the daily world backup — only backup.js reads them
    match /backupTokens/{id} {
      allow read, write: if false;
    }

    // Маркет: licensed lots are public; applications and deals — the owner / buyer reads, only the server writes
    match /marketLots/{lotId} {
      allow read: if resource == null || resource.data.status == 'listed' || (isAuthenticated() && resource.data.seller == request.auth.uid);
      allow write: if false;
    }
    match /licenceApplications/{id} {
      allow read: if isAuthenticated() && resource.data.uid == request.auth.uid;
      allow write: if false;
    }
    match /marketDeals/{id} {
      allow read: if isAuthenticated() && (resource.data.seller == request.auth.uid || resource.data.buyer == request.auth.uid);
      allow write: if false;
    }

    // Executor keys (Claude Code via the MCP server): the id is sha256 of the key, the key itself is never stored.
    // The author makes one per game in the Game Bible and can revoke it; the server only reads them.
    // Telemetry ingest keys (sha256 of wwi_…) — only the experience / telemetryIngest functions touch them
    match /ingestKeys/{id} {
      allow read, write: if false;
    }

    // Mini-Marketing: channel credentials and the publishing queue — only the marketing functions touch them
    match /marketingSecrets/{id} {
      allow read, write: if false;
    }
    match /marketingQueue/{id} {
      allow read, write: if false;
    }
    // GitHub tokens of games' repositories — only the gamedevPlan function reads them
    match /repoTokens/{id} {
      allow read, write: if false;
    }
    // 💬 Агенти (v2.148) — Telegram links, link codes, the game's chat, approval codes, the daily digest: only functions/src/agents.js
    match /tgLinks/{id} { allow read, write: if false; }
    match /tgLinkTokens/{id} { allow read, write: if false; }
    match /agentTg/{id} { allow read, write: if false; }
    match /agentApprovals/{id} { allow read, write: if false; }
    match /agentDigestQueue/{id} { allow read, write: if false; }
    // 🔌 claude.ai connector (v2.149): OAuth clients and one-time codes — functions/src/oauth.js only
    match /oauthClients/{id} { allow read, write: if false; }
    match /oauthCodes/{id} { allow read, write: if false; }

    match /mcpKeys/{keyHash} {
      allow read, delete: if isAuthenticated() && resource.data.uid == request.auth.uid;
      allow create: if isAuthenticated() && request.resource.data.uid == request.auth.uid &&
                       request.resource.data.keys().hasOnly(['uid', 'worldId', 'gameId', 'label', 'prefix', 'createdAt', 'role']) &&
                       // 💬 the agent's role (v2.148): what its MCP tools may do (functions/agent-chat.js); none = «Програміст»
                       request.resource.data.get('role', 'programmer') in ['designer', 'programmer', 'readonly'] &&
                       isWorldOwner(request.resource.data.worldId) && hasGameDev();
      allow update: if false;
    }

    function hasGameDev() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('plan', 'free') in ['worldbuilder', 'worldforge'];
    }

    // Projects collection
    match /projects/{projectId} {
      allow read: if isAuthenticated() &&
                     resource.data.owner == request.auth.uid;
      allow create: if false; // only the createProject Cloud Function (plan maxProjects + paid extra slots)
      allow update: if isAuthenticated() &&
                       resource.data.owner == request.auth.uid &&
                       request.resource.data.owner == resource.data.owner &&
                       (resource.data.get('worldId', null) == null || worldOpen(resource.data.worldId)) &&
                       (request.resource.data.get('worldId', null) == resource.data.get('worldId', null) ||
                        isWorldOwner(request.resource.data.worldId));
      allow delete: if isAuthenticated() &&
                       resource.data.owner == request.auth.uid &&
                       (resource.data.get('worldId', null) == null || worldOpen(resource.data.worldId));

      // Scenes subcollection
      match /scenes/{sceneId} {
        allow read: if isAuthenticated() && isProjectOwner(projectId);
        allow write: if isAuthenticated() && isProjectOwner(projectId) && storyOpen(projectId);
      }
    }

    // Economy operations (pricing data) - read-only for all authenticated users
    match /economy_operations/{operationId} {
      allow read: if isAuthenticated();
      allow write: if false; // Only via Cloud Functions
    }

    // Economy config (global settings) - read-only for all authenticated users
    match /economy_config/{configId} {
      allow read: if isAuthenticated();
      allow write: if false; // Only via Cloud Functions
    }

    // Usage logs - write by Cloud Functions, read by owner
    match /usage_logs/{logId} {
      allow read: if isAuthenticated() && resource.data.uid == request.auth.uid;
      allow write: if false; // Only via Cloud Functions
    }

    // Config collection (feature flags, global settings) - read-only for all authenticated users
    match /config/{configId} {
      allow read: if isAuthenticated();
      allow write: if false; // Only via Cloud Functions or Firebase Console
    }

    // Спільнота (functions/src/community.js): public showcases of worlds and games — anyone (even signed out) reads what
    // is not hidden; the owner and admins also read a hidden one. Only the server writes.
    function canSeePub(d) {
      return d.hidden != true || (request.auth != null && (d.owner == request.auth.uid || request.auth.token.admin == true));
    }
    match /community/{pubId} {
      allow read: if resource == null || canSeePub(resource.data); // a missing doc reads as «not published»
      allow write: if false;
      match /items/{itemId} {
        allow read: if canSeePub(get(/databases/$(database)/documents/community/$(pubId)).data);
        allow write: if false;
      }
      match /likes/{uid} {
        allow read: if isAuthenticated() && request.auth.uid == uid;
        allow write: if false;
      }
      match /followers/{uid} {
        allow read: if isAuthenticated() && request.auth.uid == uid;
        allow write: if false;
      }
    }
    // «Співтворці» (unpaid co-creation): one «I offer myself» and one «I am looking for people» post per user,
    // written by its owner; `hidden` and `reports` change only on the server (functions/src/community.js)
    function validCollab(d, postId) {
      return d.owner == request.auth.uid && d.type in ['offer', 'seek'] && postId == request.auth.uid + '_' + d.type &&
             d.keys().hasOnly(['owner', 'type', 'author', 'title', 'roles', 'text', 'contact', 'pubId', 'hidden', 'reports', 'createdAt', 'updatedAt']) &&
             d.title is string && d.title.size() > 0 && d.title.size() <= 120 && d.text is string && d.text.size() <= 3000 &&
             d.contact is string && d.contact.size() <= 300 && d.author is string && d.author.size() <= 80 &&
             d.roles is list && d.roles.size() <= 12 && d.pubId is string && d.pubId.size() <= 260;
    }
    match /collab/{postId} {
      allow read: if resource == null || canSeePub(resource.data);
      allow create: if isAuthenticated() && validCollab(request.resource.data, postId) &&
                       request.resource.data.hidden == false && request.resource.data.reports == 0;
      allow update: if isAuthenticated() && resource.data.owner == request.auth.uid && validCollab(request.resource.data, postId) &&
                       request.resource.data.hidden == resource.data.hidden && request.resource.data.reports == resource.data.reports;
      allow delete: if isAuthenticated() && resource.data.owner == request.auth.uid;
    }
    match /community_home/{id} {
      allow read: if true;
      allow write: if false;
    }
    match /community_reports/{id} {
      allow read: if isAuthenticated() && request.auth.token.admin == true;
      allow write: if false;
    }

    // «Попросити у фреймворку» (gamebible.js frameworkGaps): one doc per author × game × capability, id "<uid>__<gameId>__<capability>";
    // the author writes / withdraws their own, admins (the framework's author) read the demand
    match /fwRequests/{id} {
      allow read: if isAuthenticated() && (request.auth.token.admin == true || resource.data.uid == request.auth.uid);
      allow create, update: if isAuthenticated() && request.resource.data.uid == request.auth.uid && id.matches(request.auth.uid + '__.+') &&
                               request.resource.data.keys().hasOnly(['uid', 'worldId', 'gameId', 'game', 'cap', 'title', 'status', 'version', 'mechanic', 'at']);
      allow delete: if isAuthenticated() && resource.data.uid == request.auth.uid;
    }
    // AI cost watch (functions/src/cost-watch.js): the daily API dollars per user — admins read, only the server writes
    match /admin_costs/{day} {
      allow read: if isAuthenticated() && request.auth.token.admin == true;
      allow write: if false;
    }
    // «Зворотний зв'язок» (the shell's ✉ button): a signed-in author only creates their own message; admins read
    // (Акаунт → «Зворотний зв'язок») and may only mark it read; nobody edits or deletes from a client
    match /feedback/{id} {
      allow create: if isAuthenticated() && request.resource.data.uid == request.auth.uid &&
                       request.resource.data.keys().hasOnly(['uid', 'email', 'text', 'kind', 'page', 'at']) &&
                       request.resource.data.text is string && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 5000 &&
                       request.resource.data.kind in ['bug', 'idea'] &&
                       request.resource.data.email is string && request.resource.data.email.size() <= 320 &&
                       request.resource.data.page is string && request.resource.data.page.size() <= 200 &&
                       (!request.resource.data.keys().hasAny(['at']) || request.resource.data.at is timestamp);
      allow read: if isAuthenticated() && request.auth.token.admin == true;
      allow update: if isAuthenticated() && request.auth.token.admin == true &&
                       request.resource.data.diff(resource.data).affectedKeys().hasOnly(['resolved']);
      allow delete: if false;
    }
    // Admin notices (functions/src/model-watch.js): admins read them and may only mark them read
    match /admin_notices/{id} {
      allow read: if isAuthenticated() && request.auth.token.admin == true;
      allow update: if isAuthenticated() && request.auth.token.admin == true &&
                       request.resource.data.diff(resource.data).affectedKeys().hasOnly(['resolved']);
      allow create, delete: if false;
    }
  }
}
