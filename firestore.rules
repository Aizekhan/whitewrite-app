rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // TEMPORARY: Open rules for Step 1 testing
    // Will be locked down in Step 2 with real auth
    match /projects/{projectId} {
      allow read, write, create, delete: if true;
    }

    // Users collection (for Step 2)
    match /users/{userId} {
      allow read, write: if true; // Will lock down in Step 2
    }
  }
}
