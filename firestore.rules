rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    function isProjectOwner(projectId) {
      return get(/databases/$(database)/documents/projects/$(projectId)).data.owner == request.auth.uid;
    }

    // Users collection
    // Billing fields (plan, tokens*, bonusTokens, periodStart, subscription*, processedOrders, ...)
    // are server-only: written exclusively by Cloud Functions / payment webhooks.
    function clientUserFields() {
      return ['email', 'displayName', 'avatar', 'language', 'settings', 'updatedAt'];
    }

    match /users/{userId} {
      allow read: if isAuthenticated() && isOwner(userId);
      // Client may only bootstrap a free account with nothing spent
      allow create: if isAuthenticated() && isOwner(userId) &&
                       request.resource.data.keys().hasOnly(clientUserFields().concat(['plan', 'createdAt'])) &&
                       request.resource.data.plan == 'free';
      allow update: if isAuthenticated() && isOwner(userId) &&
                       request.resource.data.diff(resource.data).affectedKeys().hasOnly(clientUserFields());
      allow delete: if false; // Users can't delete themselves via client
    }
    // «Історія токенів» (functions/src/ledger.js): every move of the user's tokens — the owner reads, only the server writes
    match /users/{userId}/ledger/{entryId} {
      allow read: if isAuthenticated() && isOwner(userId);
      allow write: if false;
    }

    // Worlds (canon = source of truth). Stories (projects) reference a world via worldId.
    function isWorldOwner(worldId) {
      return get(/databases/$(database)/documents/worlds/$(worldId)).data.owner == request.auth.uid;
    }
    // Маркет (functions/src/market.js): a world under licence review or on sale is FROZEN — worlds/{w}.freeze is set and
    // cleared only by the server; until then nothing in the world, its games or its stories changes from the client
    function worldOpen(worldId) {
      return get(/databases/$(database)/documents/worlds/$(worldId)).data.get('freeze', null) == null;
    }
    // Команда (functions/src/team.js): worlds/{w}.team.{uid} = { role: admin|editor|viewer|custom, view[], edit[], viewKinds[], editKinds[] },
    // written only by the server. admin / editor read and write everything (admin's ✦ is paid by the owner on the server),
    // viewer reads everything, custom reads `view` and writes `edit` (Bible menu ids; entity kinds for the canon dossiers).
    function mem(worldId) {
      return get(/databases/$(database)/documents/worlds/$(worldId)).data.get('team', {}).get(request.auth.uid, null);
    }
    function fullRead(worldId) {
      return isWorldOwner(worldId) || (mem(worldId) != null && mem(worldId).role in ['admin', 'editor', 'viewer']);
    }
    function fullEdit(worldId) {
      return isWorldOwner(worldId) || (mem(worldId) != null && mem(worldId).role in ['admin', 'editor']);
    }
    function readSec(worldId, sec) {
      return fullRead(worldId) || (mem(worldId) != null && sec in mem(worldId).get('view', []));
    }
    function editSec(worldId, sec) {
      return fullEdit(worldId) || (mem(worldId) != null && sec in mem(worldId).get('edit', []));
    }
    function readKind(worldId, kind) {
      return fullRead(worldId) || (mem(worldId) != null && kind in mem(worldId).get('viewKinds', []));
    }
    function editKind(worldId, kind) {
      return fullEdit(worldId) || (mem(worldId) != null && kind in mem(worldId).get('editKinds', []));
    }
    function anyAccess(worldId) {
      return isWorldOwner(worldId) || mem(worldId) != null;
    }
    // game writes need Game Dev on the OWNER's plan (members work in the owner's world)
    function ownerGameDev(worldId) {
      return get(/databases/$(database)/documents/users/$(get(/databases/$(database)/documents/worlds/$(worldId)).data.owner)).data.get('plan', 'free') in ['worldbuilder', 'worldforge'];
    }
    // the Bible menu section of a game subcollection (cards carry their own `section`)
    function subSec(sub) {
      return sub in ['plan', 'tasks', 'changeRequests', 'executions'] ? 'plan'
        : sub in ['experienceIssues', 'experiments', 'playtests', 'telemetry', 'telemetryDaily', 'experience'] ? 'experience'
        : sub in ['knowledge', 'kAssets', 'kRelations'] ? 'knowledge'
        : sub in ['marketing', 'channels', 'posts'] ? 'marketing'
        : sub == 'env' ? 'settings' : sub;
    }
    function storyOpen(projectId) {
      let w = get(/databases/$(database)/documents/projects/$(projectId)).data.get('worldId', null);
      return w == null || worldOpen(w);
    }

    match /worlds/{worldId} {
      allow read: if isAuthenticated() && (resource.data.owner == request.auth.uid || request.auth.uid in resource.data.get('teamUids', []));
      allow delete: if isAuthenticated() && resource.data.owner == request.auth.uid && resource.data.get('freeze', null) == null;
      // worlds/{w}.cosmograph (Космограф access, paid monthly) is written only by functions/src/cosmograph.js; .freeze — by market.js
      // .team / .teamUids — team.js; .backup — backup.js
      allow create: if isAuthenticated() && request.resource.data.owner == request.auth.uid &&
                       !request.resource.data.keys().hasAny(['cosmograph', 'freeze', 'team', 'teamUids', 'backup', 'licence', 'boughtFrom', 'boughtAt']);
      allow update: if isAuthenticated() && resource.data.get('freeze', null) == null &&
                       !request.resource.data.diff(resource.data).affectedKeys().hasAny(['owner', 'cosmograph', 'freeze', 'team', 'teamUids', 'backup', 'licence', 'boughtFrom', 'boughtAt']) &&
                       (resource.data.owner == request.auth.uid || memberWorldEdit());
      function memberWorldEdit() {
        let m = resource.data.get('team', {}).get(request.auth.uid, null);
        let keys = request.resource.data.diff(resource.data).affectedKeys();
        return m != null && keys.hasOnly(['tagline', 'summary', 'facts', 'rules', 'cosmos', 'updatedAt']) &&
               (m.role in ['admin', 'editor'] || (
                 (!keys.hasAny(['tagline', 'summary', 'facts']) || 'world' in m.get('edit', [])) &&
                 (!keys.hasAny(['rules']) || 'laws' in m.get('edit', [])) &&
                 (!keys.hasAny(['cosmos']) || 'cosmology' in m.get('edit', []))));
      }

      match /entities/{entityId} {
        allow read: if isAuthenticated() && readKind(worldId, resource.data.kind);
        allow create, update: if isAuthenticated() && editKind(worldId, request.resource.data.kind) && worldOpen(worldId);
        allow delete: if isAuthenticated() && editKind(worldId, resource.data.kind) && worldOpen(worldId);
      }

      // Culture of the world (peoples, languages, faith, customs) — World Bible «Культура».
      match /lore/{loreId} {
        allow read: if isAuthenticated() && readSec(worldId, 'culture');
        allow write: if isAuthenticated() && editSec(worldId, 'culture') && worldOpen(worldId);
      }

      // Games built on this canon (one canon → many games): game doc + cards + production plan.
      // Writing needs a plan with allowGameDev (functions/plans.js); reading stays with the owner whatever the plan.
      // Only the subcollections the Game Bible page itself edits are client-writable; everything else under a game
      // (telemetry, telemetryDaily, experience metrics, executions, and every future server-side record: activity log,
      // project knowledge, marketing posts…) is written by Cloud Functions only — the owner reads it.
      match /games/{gameId} {
        allow read: if isAuthenticated() && anyAccess(worldId);
        allow write: if isAuthenticated() && fullEdit(worldId) && ownerGameDev(worldId) && worldOpen(worldId);
      }
      // cards: by their own section (a member with chosen sections queries one section at a time)
      match /games/{gameId}/cards/{cardId} {
        allow read: if isAuthenticated() && readSec(worldId, resource.data.section);
        allow create, update: if isAuthenticated() && editSec(worldId, request.resource.data.section) && ownerGameDev(worldId) && worldOpen(worldId);
        allow delete: if isAuthenticated() && editSec(worldId, resource.data.section) && ownerGameDev(worldId) && worldOpen(worldId);
      }
      match /games/{gameId}/{sub}/{docId} {
        allow read: if isAuthenticated() && sub != 'cards' && readSec(worldId, subSec(sub));
        allow write: if isAuthenticated() && sub != 'cards' && editSec(worldId, subSec(sub)) && ownerGameDev(worldId) && worldOpen(worldId) &&
                        sub in ['plan', 'tasks', 'changeRequests', 'experienceIssues', 'experiments', 'playtests', 'quests', 'dialogues'];
        // the author deleting the game (server-written records: executor log, Project Knowledge, activity log, environment)
        allow delete: if isAuthenticated() && isWorldOwner(worldId) && worldOpen(worldId) &&
                         sub in ['executions', 'knowledge', 'kAssets', 'kRelations', 'activity', 'env', 'posts', 'channels', 'marketing'];
      }
      match /games/{gameId}/{sub}/{docId}/{rest=**} {
        allow read: if isAuthenticated() && readSec(worldId, subSec(sub));
      }
      // Development activity log: Claude Code writes entries (MCP); the author only re-marks privacy, or deletes with the game
      match /games/{gameId}/activity/{sessionId}/entries/{entryId} {
        allow update: if isAuthenticated() && isWorldOwner(worldId) && hasGameDev() && worldOpen(worldId) &&
                         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['privacy', 'reviewedAt']) &&
                         request.resource.data.privacy in ['internal', 'confidential', 'spoiler', 'excluded', 'marketing_approved'];
        allow delete: if isAuthenticated() && isWorldOwner(worldId);
      }
    }

    // Друзі (team.js): the owner reads, only the server writes
    match /users/{userId}/friends/{friendId} {
      allow read: if isAuthenticated() && isOwner(userId);
      allow write: if false;
    }
    // GitHub tokens of the daily world backup — only backup.js reads them
    match /backupTokens/{id} {
      allow read, write: if false;
    }

    // Маркет: licensed lots are public; applications, deals and seller accounts — the owner / buyer reads, only the server writes
    match /marketLots/{lotId} {
      allow read: if resource == null || resource.data.status == 'listed' || (isAuthenticated() && resource.data.seller == request.auth.uid);
      allow write: if false;
    }
    match /licenceApplications/{id} {
      allow read: if isAuthenticated() && resource.data.uid == request.auth.uid;
      allow write: if false;
    }
    match /marketDeals/{id} {
      allow read: if isAuthenticated() && (resource.data.seller == request.auth.uid || resource.data.buyer == request.auth.uid);
      allow write: if false;
    }
    match /sellers/{uid} {
      allow read: if isAuthenticated() && isOwner(uid);
      allow write: if false;
    }

    // Executor keys (Claude Code via the MCP server): the id is sha256 of the key, the key itself is never stored.
    // The author makes one per game in the Game Bible and can revoke it; the server only reads them.
    // Telemetry ingest keys (sha256 of wwi_…) — only the experience / telemetryIngest functions touch them
    match /ingestKeys/{id} {
      allow read, write: if false;
    }

    // Mini-Marketing: channel credentials and the publishing queue — only the marketing functions touch them
    match /marketingSecrets/{id} {
      allow read, write: if false;
    }
    match /marketingQueue/{id} {
      allow read, write: if false;
    }
    // GitHub tokens of games' repositories — only the gamedevPlan function reads them
    match /repoTokens/{id} {
      allow read, write: if false;
    }

    match /mcpKeys/{keyHash} {
      allow read, delete: if isAuthenticated() && resource.data.uid == request.auth.uid;
      allow create: if isAuthenticated() && request.resource.data.uid == request.auth.uid &&
                       request.resource.data.keys().hasOnly(['uid', 'worldId', 'gameId', 'label', 'prefix', 'createdAt']) &&
                       isWorldOwner(request.resource.data.worldId) && hasGameDev();
      allow update: if false;
    }

    function hasGameDev() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('plan', 'free') in ['worldbuilder', 'worldforge'];
    }

    // Projects collection
    match /projects/{projectId} {
      allow read: if isAuthenticated() &&
                     resource.data.owner == request.auth.uid;
      allow create: if false; // only the createProject Cloud Function (plan maxProjects + paid extra slots)
      allow update: if isAuthenticated() &&
                       resource.data.owner == request.auth.uid &&
                       request.resource.data.owner == resource.data.owner &&
                       (resource.data.get('worldId', null) == null || worldOpen(resource.data.worldId)) &&
                       (request.resource.data.get('worldId', null) == resource.data.get('worldId', null) ||
                        isWorldOwner(request.resource.data.worldId));
      allow delete: if isAuthenticated() &&
                       resource.data.owner == request.auth.uid &&
                       (resource.data.get('worldId', null) == null || worldOpen(resource.data.worldId));

      // Scenes subcollection
      match /scenes/{sceneId} {
        allow read: if isAuthenticated() && isProjectOwner(projectId);
        allow write: if isAuthenticated() && isProjectOwner(projectId) && storyOpen(projectId);
      }

      // Narrative subcollection (future)
      match /narrative/{docId} {
        allow read: if isAuthenticated() && isProjectOwner(projectId);
        allow write: if isAuthenticated() && isProjectOwner(projectId);
      }

      // Director subcollection (future)
      match /director/{docId} {
        allow read: if isAuthenticated() && isProjectOwner(projectId);
        allow write: if isAuthenticated() && isProjectOwner(projectId);
      }

      // Snapshots subcollection (future)
      match /snapshots/{snapshotId} {
        allow read: if isAuthenticated() && isProjectOwner(projectId);
        allow create: if isAuthenticated() && isProjectOwner(projectId);
        allow delete: if false; // Snapshots are immutable
      }
    }

    // Reconstruction queue (future, global but user-scoped)
    match /reconstructionQueue/{queueId} {
      allow read: if isAuthenticated() &&
                     resource.data.userId == request.auth.uid;
      allow create: if isAuthenticated() &&
                       request.resource.data.userId == request.auth.uid;
      allow update: if isAuthenticated() &&
                       resource.data.userId == request.auth.uid;
      allow delete: if isAuthenticated() &&
                       resource.data.userId == request.auth.uid;
    }

    // Economy operations (pricing data) - read-only for all authenticated users
    match /economy_operations/{operationId} {
      allow read: if isAuthenticated();
      allow write: if false; // Only via Cloud Functions
    }

    // Economy config (global settings) - read-only for all authenticated users
    match /economy_config/{configId} {
      allow read: if isAuthenticated();
      allow write: if false; // Only via Cloud Functions
    }

    // Usage logs - write by Cloud Functions, read by owner
    match /usage_logs/{logId} {
      allow read: if isAuthenticated() && resource.data.uid == request.auth.uid;
      allow write: if false; // Only via Cloud Functions
    }

    // Config collection (feature flags, global settings) - read-only for all authenticated users
    match /config/{configId} {
      allow read: if isAuthenticated();
      allow write: if false; // Only via Cloud Functions or Firebase Console
    }

    // Спільнота (functions/src/community.js): public showcases of worlds and games — anyone (even signed out) reads what
    // is not hidden; the owner and admins also read a hidden one. Only the server writes.
    function canSeePub(d) {
      return d.hidden != true || (request.auth != null && (d.owner == request.auth.uid || request.auth.token.admin == true));
    }
    match /community/{pubId} {
      allow read: if resource == null || canSeePub(resource.data); // a missing doc reads as «not published»
      allow write: if false;
      match /items/{itemId} {
        allow read: if canSeePub(get(/databases/$(database)/documents/community/$(pubId)).data);
        allow write: if false;
      }
      match /likes/{uid} {
        allow read: if isAuthenticated() && request.auth.uid == uid;
        allow write: if false;
      }
    }
    // «Співтворці» (unpaid co-creation): one «I offer myself» and one «I am looking for people» post per user,
    // written by its owner; `hidden` and `reports` change only on the server (functions/src/community.js)
    function validCollab(d, postId) {
      return d.owner == request.auth.uid && d.type in ['offer', 'seek'] && postId == request.auth.uid + '_' + d.type &&
             d.keys().hasOnly(['owner', 'type', 'author', 'title', 'roles', 'text', 'contact', 'pubId', 'hidden', 'reports', 'createdAt', 'updatedAt']) &&
             d.title is string && d.title.size() > 0 && d.title.size() <= 120 && d.text is string && d.text.size() <= 3000 &&
             d.contact is string && d.contact.size() <= 300 && d.author is string && d.author.size() <= 80 &&
             d.roles is list && d.roles.size() <= 12 && d.pubId is string && d.pubId.size() <= 260;
    }
    match /collab/{postId} {
      allow read: if resource == null || canSeePub(resource.data);
      allow create: if isAuthenticated() && validCollab(request.resource.data, postId) &&
                       request.resource.data.hidden == false && request.resource.data.reports == 0;
      allow update: if isAuthenticated() && resource.data.owner == request.auth.uid && validCollab(request.resource.data, postId) &&
                       request.resource.data.hidden == resource.data.hidden && request.resource.data.reports == resource.data.reports;
      allow delete: if isAuthenticated() && resource.data.owner == request.auth.uid;
    }
    match /community_home/{id} {
      allow read: if true;
      allow write: if false;
    }
    match /community_reports/{id} {
      allow read: if isAuthenticated() && request.auth.token.admin == true;
      allow write: if false;
    }

    // Admin notices (functions/src/model-watch.js): admins read them and may only mark them read
    match /admin_notices/{id} {
      allow read: if isAuthenticated() && request.auth.token.admin == true;
      allow update: if isAuthenticated() && request.auth.token.admin == true &&
                       request.resource.data.diff(resource.data).affectedKeys().hasOnly(['resolved']);
      allow create, delete: if false;
    }
  }
}
