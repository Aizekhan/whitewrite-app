rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    function isProjectOwner(projectId) {
      return get(/databases/$(database)/documents/projects/$(projectId)).data.owner == request.auth.uid;
    }

    // Users collection
    // Billing fields (plan, tokens*, bonusTokens, periodStart, subscription*, processedOrders, ...)
    // are server-only: written exclusively by Cloud Functions / payment webhooks.
    function clientUserFields() {
      return ['email', 'displayName', 'avatar', 'language', 'settings', 'updatedAt'];
    }

    match /users/{userId} {
      allow read: if isAuthenticated() && isOwner(userId);
      // Client may only bootstrap a free account with nothing spent
      allow create: if isAuthenticated() && isOwner(userId) &&
                       request.resource.data.keys().hasOnly(clientUserFields().concat(['plan', 'createdAt'])) &&
                       request.resource.data.plan == 'free';
      allow update: if isAuthenticated() && isOwner(userId) &&
                       request.resource.data.diff(resource.data).affectedKeys().hasOnly(clientUserFields());
      allow delete: if false; // Users can't delete themselves via client
    }

    // Worlds (canon = source of truth). Stories (projects) reference a world via worldId.
    function isWorldOwner(worldId) {
      return get(/databases/$(database)/documents/worlds/$(worldId)).data.owner == request.auth.uid;
    }

    match /worlds/{worldId} {
      allow read, delete: if isAuthenticated() && resource.data.owner == request.auth.uid;
      // worlds/{w}.cosmograph (Космограф access, paid monthly) is written only by functions/src/cosmograph.js
      allow create: if isAuthenticated() && request.resource.data.owner == request.auth.uid &&
                       !('cosmograph' in request.resource.data);
      allow update: if isAuthenticated() && resource.data.owner == request.auth.uid &&
                       request.resource.data.owner == resource.data.owner &&
                       request.resource.data.get('cosmograph', null) == resource.data.get('cosmograph', null);

      match /entities/{entityId} {
        allow read, write: if isAuthenticated() && isWorldOwner(worldId);
      }

      // Culture of the world (peoples, languages, faith, customs) — World Bible «Культура».
      match /lore/{loreId} {
        allow read, write: if isAuthenticated() && isWorldOwner(worldId);
      }

      // Quests and dialogues of the world (World Bible «Квести» / «Діалоги», functions/narrative-validate.js checks them).
      // World level, so Novelist (no game dev) can write them; games and Claude Code read the approved ones via MCP.
      match /quests/{questId} {
        allow read, delete: if isAuthenticated() && isWorldOwner(worldId); // delete: the author removing the world on any plan
        allow create, update: if isAuthenticated() && isWorldOwner(worldId) && hasQuests();
      }
      match /dialogues/{dialogueId} {
        allow read, delete: if isAuthenticated() && isWorldOwner(worldId); // delete: the author removing the world on any plan
        allow create, update: if isAuthenticated() && isWorldOwner(worldId) && hasQuests();
      }

      // Games built on this canon (one canon → many games): game doc + cards + production plan.
      // Writing needs a plan with allowGameDev (functions/plans.js); reading stays with the owner whatever the plan.
      // Only the subcollections the Game Bible page itself edits are client-writable; everything else under a game
      // (telemetry, telemetryDaily, experience metrics, executions, and every future server-side record: activity log,
      // project knowledge, marketing posts…) is written by Cloud Functions only — the owner reads it.
      match /games/{gameId} {
        allow read: if isAuthenticated() && isWorldOwner(worldId);
        allow write: if isAuthenticated() && isWorldOwner(worldId) && hasGameDev();
      }
      match /games/{gameId}/{sub}/{docId} {
        allow read: if isAuthenticated() && isWorldOwner(worldId);
        allow write: if isAuthenticated() && isWorldOwner(worldId) && hasGameDev() &&
                        sub in ['cards', 'plan', 'tasks', 'changeRequests', 'experienceIssues', 'experiments', 'playtests'];
        allow delete: if isAuthenticated() && isWorldOwner(worldId) && sub == 'executions'; // the author deleting the game
      }
      match /games/{gameId}/{sub}/{docId}/{rest=**} {
        allow read: if isAuthenticated() && isWorldOwner(worldId);
      }
    }

    // Executor keys (Claude Code via the MCP server): the id is sha256 of the key, the key itself is never stored.
    // The author makes one per game in the Game Bible and can revoke it; the server only reads them.
    // Telemetry ingest keys (sha256 of wwi_…) — only the experience / telemetryIngest functions touch them
    match /ingestKeys/{id} {
      allow read, write: if false;
    }

    // GitHub tokens of games' repositories — only the gamedevPlan function reads them
    match /repoTokens/{id} {
      allow read, write: if false;
    }

    match /mcpKeys/{keyHash} {
      allow read, delete: if isAuthenticated() && resource.data.uid == request.auth.uid;
      allow create: if isAuthenticated() && request.resource.data.uid == request.auth.uid &&
                       request.resource.data.keys().hasOnly(['uid', 'worldId', 'gameId', 'label', 'prefix', 'createdAt']) &&
                       isWorldOwner(request.resource.data.worldId) && hasGameDev();
      allow update: if false;
    }

    function hasGameDev() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('plan', 'free') in ['worldbuilder', 'worldforge'];
    }

    // allowQuests in functions/paid-features.js (from Novelist)
    function hasQuests() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('plan', 'free') in ['novelist', 'worldbuilder', 'worldforge'];
    }

    // Projects collection
    match /projects/{projectId} {
      allow read: if isAuthenticated() &&
                     resource.data.owner == request.auth.uid;
      allow create: if false; // only the createProject Cloud Function (plan maxProjects + paid extra slots)
      allow update: if isAuthenticated() &&
                       resource.data.owner == request.auth.uid &&
                       request.resource.data.owner == resource.data.owner &&
                       (request.resource.data.get('worldId', null) == resource.data.get('worldId', null) ||
                        isWorldOwner(request.resource.data.worldId));
      allow delete: if isAuthenticated() &&
                       resource.data.owner == request.auth.uid;

      // Scenes subcollection
      match /scenes/{sceneId} {
        allow read: if isAuthenticated() && isProjectOwner(projectId);
        allow write: if isAuthenticated() && isProjectOwner(projectId);
      }

      // Narrative subcollection (future)
      match /narrative/{docId} {
        allow read: if isAuthenticated() && isProjectOwner(projectId);
        allow write: if isAuthenticated() && isProjectOwner(projectId);
      }

      // Director subcollection (future)
      match /director/{docId} {
        allow read: if isAuthenticated() && isProjectOwner(projectId);
        allow write: if isAuthenticated() && isProjectOwner(projectId);
      }

      // Snapshots subcollection (future)
      match /snapshots/{snapshotId} {
        allow read: if isAuthenticated() && isProjectOwner(projectId);
        allow create: if isAuthenticated() && isProjectOwner(projectId);
        allow delete: if false; // Snapshots are immutable
      }
    }

    // Reconstruction queue (future, global but user-scoped)
    match /reconstructionQueue/{queueId} {
      allow read: if isAuthenticated() &&
                     resource.data.userId == request.auth.uid;
      allow create: if isAuthenticated() &&
                       request.resource.data.userId == request.auth.uid;
      allow update: if isAuthenticated() &&
                       resource.data.userId == request.auth.uid;
      allow delete: if isAuthenticated() &&
                       resource.data.userId == request.auth.uid;
    }

    // Economy operations (pricing data) - read-only for all authenticated users
    match /economy_operations/{operationId} {
      allow read: if isAuthenticated();
      allow write: if false; // Only via Cloud Functions
    }

    // Economy config (global settings) - read-only for all authenticated users
    match /economy_config/{configId} {
      allow read: if isAuthenticated();
      allow write: if false; // Only via Cloud Functions
    }

    // Usage logs - write by Cloud Functions, read by owner
    match /usage_logs/{logId} {
      allow read: if isAuthenticated() && resource.data.uid == request.auth.uid;
      allow write: if false; // Only via Cloud Functions
    }

    // Config collection (feature flags, global settings) - read-only for all authenticated users
    match /config/{configId} {
      allow read: if isAuthenticated();
      allow write: if false; // Only via Cloud Functions or Firebase Console
    }

    // Admin notices (functions/src/model-watch.js): admins read them and may only mark them read
    match /admin_notices/{id} {
      allow read: if isAuthenticated() && request.auth.token.admin == true;
      allow update: if isAuthenticated() && request.auth.token.admin == true &&
                       request.resource.data.diff(resource.data).affectedKeys().hasOnly(['resolved']);
      allow create, delete: if false;
    }
  }
}
