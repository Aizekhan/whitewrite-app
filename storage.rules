rules_version = '2';
// Files on Game Bible cards (prefabs, models, images, audio). Mirrors firestore.rules for worlds/{w}/games:
// the world owner reads; dossier files need a plan that edits the canon (allowWorldTree, Storyteller+); game files — any plan
// (allowGameDesign); both up to 20 MB a file below Worldbuilder and 200 MB on it.
service firebase.storage {
  match /b/{bucket}/o {
    function isWorldOwner(worldId) {
      return firestore.get(/databases/(default)/documents/worlds/$(worldId)).data.owner == request.auth.uid;
    }
    // Маркет: a world under licence review / on sale is frozen (worlds/{w}.freeze, set only by functions/src/market.js)
    function worldOpen(worldId) {
      return firestore.get(/databases/(default)/documents/worlds/$(worldId)).data.get('freeze', null) == null;
    }
    // Команда (functions/src/team.js): any member reads the world's files; admin / editor write them (on the owner's plan)
    function member(worldId) {
      return firestore.get(/databases/(default)/documents/worlds/$(worldId)).data.get('team', {}).get(request.auth.uid, null);
    }
    function canRead(worldId) { return isWorldOwner(worldId) || member(worldId) != null; }
    // «Вибрані розділи» (role custom): a card's files by the card's section, a dossier's by the entity's kind — as firestore.rules
    // readSec / readKind. The card / entity doc is read only for such a member (≤ 2 documents per evaluation).
    function fullRead(worldId) { return isWorldOwner(worldId) || (member(worldId) != null && member(worldId).role in ['admin', 'editor', 'viewer']); }
    function readCardFiles(worldId, gameId, cardId) {
      return fullRead(worldId) || (member(worldId) != null &&
        firestore.get(/databases/(default)/documents/worlds/$(worldId)/games/$(gameId)/cards/$(cardId)).data.section in member(worldId).get('view', []));
    }
    function readEntityFiles(worldId, entityId) {
      return fullRead(worldId) || (member(worldId) != null && (entityId == 'cosmos' ? 'cosmology' in member(worldId).get('view', []) :
        entityId.matches('lore_.*') ? 'culture' in member(worldId).get('view', []) :
        firestore.get(/databases/(default)/documents/worlds/$(worldId)/entities/$(entityId)).data.kind in member(worldId).get('viewKinds', [])));
    }
    // a member with the right to edit that section (role custom: the entity's kind, «Культура» for a culture entry, «Космологія» for the sky)
    function editEntityFiles(worldId, entityId) {
      return canWrite(worldId) || (member(worldId) != null && member(worldId).role == 'custom' && (entityId == 'cosmos' ? 'cosmology' in member(worldId).get('edit', []) :
        entityId.matches('lore_.*') ? 'culture' in member(worldId).get('edit', []) :
        firestore.get(/databases/(default)/documents/worlds/$(worldId)/entities/$(entityId)).data.kind in member(worldId).get('editKinds', [])));
    }
    function canWrite(worldId) {
      return isWorldOwner(worldId) || (member(worldId) != null && member(worldId).role in ['admin', 'editor']);
    }
    function ownerPlan(worldId) {
      return firestore.get(/databases/(default)/documents/users/$(firestore.get(/databases/(default)/documents/worlds/$(worldId)).data.owner)).data.get('plan', 'free');
    }
    // the plans with allowGameDev (functions/paid-features.js) — tests/canon-plans.test.cjs checks the list against the registry
    function ownerGameDev(worldId) {
      return ownerPlan(worldId) in ['worldbuilder', 'worldforge'];
    }
    // a file a page or the storage domain could run as a document (audit 2026-11-19): never on a card, a dossier or a cover
    function safeType() {
      return request.resource.contentType == null ||
             !request.resource.contentType.lower().matches('.*(html|javascript|ecmascript|svg).*');
    }
    // the shell names an avatar / a story cover «<Date.now()>_<file name>» (White.html): only such names, raster pictures only
    function shellPic(file) {
      return file.matches('[0-9]{13}_[A-Za-z0-9_.-]{1,80}') && request.resource.contentType.matches('image/(png|jpeg|webp|gif|avif)');
    }
    // the plans that edit the canon — functions/paid-features.js 'bible' (allowWorldTree), the same list as firestore.rules canonPlans()
    // (tests/canon-plans.test.cjs checks both against the registry)
    function ownerCanon(worldId) {
      return ownerPlan(worldId) in ['storyteller', 'novelist', 'worldbuilder', 'worldforge'];
    }

    // World-level files of canon entities (dossier and culture pictures, models, the sky's maps), shared by every story and game:
    // from the plan that edits the canon (Storyteller+), up to 20 MB a file below Worldbuilder and 200 MB on it — as game files (v2.118.0)
    match /worlds/{worldId}/files/{entityId}/{rest=**} {
      allow read: if request.auth != null && readEntityFiles(worldId, entityId);
      allow delete: if request.auth != null && editEntityFiles(worldId, entityId) && ownerCanon(worldId) && worldOpen(worldId);
      allow create, update: if request.auth != null && editEntityFiles(worldId, entityId) && ownerCanon(worldId) && worldOpen(worldId) && safeType() &&
                               request.resource.size < (ownerGameDev(worldId) ? 200 : 20) * 1024 * 1024;
    }

    // The world's cover on its card (Світи, the world hub): an image ≤ 10 MB or an MP4/WebM video ≤ 50 MB, any plan.
    match /worlds/{worldId}/cover/{file} {
      allow read: if request.auth != null && canRead(worldId);
      allow delete: if request.auth != null && isWorldOwner(worldId) && worldOpen(worldId);
      allow create, update: if request.auth != null && isWorldOwner(worldId) && worldOpen(worldId) &&
                               ((request.resource.contentType.matches('image/(png|jpeg|webp|gif|avif)') && request.resource.size < 10 * 1024 * 1024) ||
                                (request.resource.contentType.matches('video/(mp4|webm)') && request.resource.size < 50 * 1024 * 1024));
    }

    // A game's cover and title image («Огляд гри»): the same limits as the world's, any plan. Not on the 🎓 demo game (games/{g}.demo —
    // read-only, firestore.rules notDemo): the world doc + the game doc are the two documents a Storage rule may read. Card files below
    // cannot check it (world + the owner's plan are already two) — a demo card's files[] is a Firestore write the rules refuse anyway.
    match /worlds/{worldId}/games/{gameId}/cover/{file} {
      allow read: if request.auth != null && canRead(worldId);
      allow delete: if request.auth != null && isWorldOwner(worldId) && worldOpen(worldId);
      allow create, update: if request.auth != null && isWorldOwner(worldId) && worldOpen(worldId) &&
                               firestore.get(/databases/(default)/documents/worlds/$(worldId)/games/$(gameId)).data.get('demo', false) != true &&
                               ((request.resource.contentType.matches('image/(png|jpeg|webp|gif|avif)') && request.resource.size < 10 * 1024 * 1024) ||
                                (request.resource.contentType.matches('video/(mp4|webm)') && request.resource.size < 50 * 1024 * 1024));
    }
    // A story's cover (Біблія → «Історії і хроніка» → ✎, the shell's story form): the story's owner, an image ≤ 10 MB.
    // projects/{p}.cover keeps the download URL, .coverPath the file; deleting the story removes it (functions/src/cleanup.js projectDeleted).
    match /projects/{projectId}/cover/{file} {
      allow read: if request.auth != null && firestore.get(/databases/(default)/documents/projects/$(projectId)).data.owner == request.auth.uid;
      allow delete: if request.auth != null && firestore.get(/databases/(default)/documents/projects/$(projectId)).data.owner == request.auth.uid;
      allow create, update: if request.auth != null && firestore.get(/databases/(default)/documents/projects/$(projectId)).data.owner == request.auth.uid &&
                               shellPic(file) && request.resource.size < 10 * 1024 * 1024;
    }
    // The author's avatar (Акаунт → profile): only its owner writes, an image ≤ 2 MB; the URL goes to Auth photoURL and users/{uid}.avatar
    match /users/{userId}/avatar/{file} {
      allow read: if request.auth != null;
      allow delete: if request.auth != null && request.auth.uid == userId;
      allow create, update: if request.auth != null && request.auth.uid == userId &&
                               shellPic(file) && request.resource.size < 2 * 1024 * 1024;
    }
    // 🎞 the WhiteWrite animation library (functions/forge.js ANIM_STORE): per-body-type GLBs for the Forge's 3D preview, ours to give out.
    // Any signed-in user reads; nobody writes from a client (uploaded with the admin SDK).
    match /library/anims/{rest=**} {
      allow read: if request.auth != null;
      allow write: if false;
    }
    match /worlds/{worldId}/games/{gameId}/files/{cardId}/{rest=**} {
      allow read: if request.auth != null && readCardFiles(worldId, gameId, cardId);
      allow delete: if request.auth != null && canWrite(worldId) && worldOpen(worldId);
      allow create, update: if request.auth != null && canWrite(worldId) && worldOpen(worldId) && safeType() &&
                               request.resource.size < (ownerGameDev(worldId) ? 200 : 20) * 1024 * 1024;
    }
  }
}
